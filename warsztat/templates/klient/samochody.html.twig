{% extends 'base.html.twig' %}

{% block title %}Moje samochody{% endblock %}

{% block body %}
<h1>Moje samochody</h1>

{% if samochody is empty %}
    <p>Nie masz jeszcze żadnych samochodów.</p>
{% else %}
<table border="1" cellpadding="5">
    <tr>
        <th>Marka</th>
        <th>Model</th>
        <th>Rok</th>
        <th>Rejestracja</th>
        <th>VIN</th>
    </tr>
    {% for s in samochody %}
        <tr>
            <td>{{ s.marka }}</td>
            <td>{{ s.model }}</td>
            <td>{{ s.rokProdukcji }}</td>
            <td>{{ s.numerRejestracyjny }}</td>
            <td>{{ s.vin }}</td>
        </tr>
    {% endfor %}
</table>
{% endif %}

<a href="/klient">← Powrót do panelu</a>
{% endblock %}

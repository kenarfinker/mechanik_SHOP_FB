<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Warsztat samochodowy{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body>

<header>
    <h1>Warsztat Samochodowy</h1>
    {% if app.user %}
    {% if 'ROLE_ADMIN' in app.user.roles %}
        <a href="/admin">Profil</a>
    {% endif %}

    {% if 'ROLE_MECHANIK' in app.user.roles %}
        <a href="/mechanik">Profil</a>
    {% endif %}

    {% if 'ROLE_KLIENT' in app.user.roles %}
        <a href="/klient">Profil</a>
    {% endif %}

    <a href="{{ path('app_logout') }}">Wyloguj</a>
{% endif %}

    <nav>
        <a href="/">Strona główna</a>
        <a href="{{ path('oferta') }}">Oferta</a>
        <a href="{{ path('kontakt') }}">Kontakt</a>
    </nav>
</header>

<main>
    {% block body %}{% endblock %}
</main>

<footer>
    <p>&copy; 2026 Warsztat Samochodowy</p>
</footer>

</body>
</html>

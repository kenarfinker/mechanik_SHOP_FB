<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Warsztat samochodowy{% endblock %}</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header>
    <h1>Warsztat Samochodowy</h1>
    {% if app.user %}
    <a href="{{ path('app_logout') }}">Wyloguj</a>
    {% endif %}
    <nav>
        <a href="/">Strona główna</a>
        <a href="/oferta">Oferta</a>
        <a href="/kontakt">Kontakt</a>
    </nav>
</header>

<main>
    {% block body %}{% endblock %}
</main>

<footer>
    <p>&copy; 2026 Warsztat Samochodowy</p>
</footer>

</body>
</html>

{% extends 'base.html.twig' %}

{% block title %}Katalog usług{% endblock %}

{% block body %}
<h1>Katalog usług</h1>

{% for message in app.flashes('error') %}
  <div style="color:red">{{ message }}</div>
{% endfor %}

<h3>Dodaj usługę</h3>
<form method="post" action="{{ path('mechanik_katalog') }}">
  <input type="hidden" name="_token" value="{{ csrf_token('usluga_add') }}">

  <label>Nazwa:</label>
  <input type="text" name="nazwa" required>

  <label>Cena:</label>
  <input type="text" name="cena" required placeholder="np. 199.99">

  <button type="submit">Dodaj</button>
</form>

<hr>

<h3>Lista usług</h3>

<table border="1" cellpadding="6" cellspacing="0">
  <thead>
    <tr>
      <th>ID</th>
      <th>Nazwa</th>
      <th>Cena</th>
      <th>Akcje</th>
    </tr>
  </thead>
  <tbody>
    {% for u in uslugi %}
      <tr>
        <td>{{ u.id }}</td>
        <td>{{ u.nazwa }}</td>
        <td>{{ u.cena }}</td>
        <td>
          <form method="post" action="{{ path('mechanik_usluga_usun', {id: u.id}) }}" style="display:inline">
            <input type="hidden" name="_token" value="{{ csrf_token('usluga_del_' ~ u.id) }}">
            <button type="submit" onclick="return confirm('Usunąć usługę?')">Usuń</button>
          </form>
        </td>
      </tr>
    {% else %}
      <tr><td colspan="4">Brak usług.</td></tr>
    {% endfor %}
  </tbody>
</table>

<p><a href="{{ path('mechanik_panel') }}">← Wróć do panelu</a></p>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Historia zleceń{% endblock %}

{% block body %}
<h1>Historia zleceń</h1>

<table border="1" cellpadding="6" cellspacing="0">
  <thead>
    <tr>
      <th>ID</th>
      <th>Status</th>
      <th>Auto</th>
      <th>Klient</th>
      <th>Mechanik</th>
      <th>Data przyjęcia</th>
      <th>Data zakończenia</th>
      <th>Opis</th>
    </tr>
  </thead>
  <tbody>
    {% for z in zlecenia %}
      <tr>
        <td>{{ z.id }}</td>
        <td>{{ z.status }}</td>
        <td>{{ z.marka }} {{ z.model }} ({{ z.numer_rejestracyjny }})</td>
        <td>{{ z.klient_imie }} {{ z.klient_nazwisko }}</td>
        <td>
          {% if z.mechanik_imie %}
            {{ z.mechanik_imie }} {{ z.mechanik_nazwisko }}
          {% else %}
            —
          {% endif %}
        </td>
        <td>{{ z.data_przyjecia }}</td>
        <td>{{ z.data_zakonczenia ?: '—' }}</td>
        <td>{{ z.opis ?: '—' }}</td>
      </tr>
    {% else %}
      <tr><td colspan="8">Brak zleceń.</td></tr>
    {% endfor %}
  </tbody>
</table>

<p><a href="{{ path('mechanik_panel') }}">← Wróć do panelu</a></p>
{% endblock %}
